[Unit]
Description=zdx API (current)
After=network.target docker.service

[Service]
Type=simple
ExecStart=/home/zdx/home/versions/current/dx-server
Restart=on-failure
RestartSec=3
WorkingDirectory=/home/zdx

User=zdx
Group=zdx

Environment=ZDX_HOME=/home/zdx/home
Environment=ZDX_SLOT=current
Environment=PORT=7600
Environment=STATIC_DIR=/home/zdx/home/versions/current/public
Environment=DATABASE_URL=postgres://zdx:zdx@localhost:7650/zdx?sslmode=disable
Environment=ZDX_PROJECT_SLUG=zdx

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
ReadWritePaths=/home/zdx/home

[Install]
WantedBy=multi-user.target
