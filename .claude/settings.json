{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if echo \"$input\" | jq -r '.tool_input.command' 2>/dev/null | grep -q 'git commit'; then bin/clown-check; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "zig-lsp@zircote-lsp": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "lspServers": {
    "zig": {
      "command": "/home/nthalk/.local/bin/zls",
      "extensionToLanguage": {
        ".zig": "zig"
      }
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact"
      }
    }
  }
}
