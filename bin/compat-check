#!/usr/bin/env bash
# Schema compatibility check for rolling deploys.
#
# Spins up two ephemeral Postgres containers:
#   current  — schema/shipped.sql   (what is running in production now)
#   next     — all migrations applied (what we are about to ship)
#
# Runs the test suite against both. If tests pass on current schema, the
# migration is forward-compatible and a zero-downtime rolling deploy is safe.
# If tests fail on current schema, the migration is incompatible — ship with
#   bin/ship --non-compatible-migration
# to use the maintenance-mode deploy path instead.
#
# Exit codes:
#   0  compatible   — safe to rolling-deploy
#   1  incompatible — use --non-compatible-migration
#   2  error        — test suite itself broken (fix before shipping)
#
# Requires: docker, go, pg_dump available locally.
set -euo pipefail
cd "$(dirname "$0")/.."

PG_IMAGE="postgres:17"
PG_USER="zdx"
PG_PASS="zdx"
PG_DB="zdx"
PORT_CURRENT=17650
PORT_NEXT=17651

SHIPPED_SQL="schema/shipped.sql"
NEXT_SQL="schema/next.sql"

cleanup() {
  docker rm -f zdx-compat-current zdx-compat-next 2>/dev/null || true
}
trap cleanup EXIT

echo "[compat] Starting ephemeral Postgres containers..."

start_pg() {
  local name="$1" port="$2"
  docker run -d --name "$name" \
    -e POSTGRES_USER="$PG_USER" \
    -e POSTGRES_PASSWORD="$PG_PASS" \
    -e POSTGRES_DB="$PG_DB" \
    -p "127.0.0.1:${port}:5432" \
    "$PG_IMAGE" >/dev/null
}

start_pg zdx-compat-current $PORT_CURRENT
start_pg zdx-compat-next    $PORT_NEXT

wait_pg() {
  local name="$1" port="$2"
  for i in $(seq 1 30); do
    if docker exec "$name" pg_isready -U "$PG_USER" -q 2>/dev/null; then return; fi
    sleep 1
  done
  echo "[compat] ERROR: $name did not become ready" && exit 2
}

echo "[compat] Waiting for Postgres..."
wait_pg zdx-compat-current $PORT_CURRENT
wait_pg zdx-compat-next    $PORT_NEXT

DSN_CURRENT="postgres://${PG_USER}:${PG_PASS}@localhost:${PORT_CURRENT}/${PG_DB}?sslmode=disable"
DSN_NEXT="postgres://${PG_USER}:${PG_PASS}@localhost:${PORT_NEXT}/${PG_DB}?sslmode=disable"

# ── Apply current schema (shipped.sql) ────────────────────────────────────────

if [ -s "$SHIPPED_SQL" ] && ! grep -q "^--$" "$SHIPPED_SQL"; then
  echo "[compat] Applying shipped schema to current container..."
  docker exec -i zdx-compat-current \
    psql -U "$PG_USER" -d "$PG_DB" < "$SHIPPED_SQL"
else
  echo "[compat] No shipped schema yet — skipping current-schema test."
  SKIP_CURRENT=true
fi

# ── Apply next schema (all migrations) ────────────────────────────────────────

echo "[compat] Applying migrations to next container..."
DATABASE_URL="$DSN_NEXT" ./bin/dx migrate up

# Dump next schema for committing to repo.
echo "[compat] Dumping next schema to schema/next.sql..."
docker exec zdx-compat-next \
  pg_dump -U "$PG_USER" -d "$PG_DB" --schema-only --no-owner --no-privileges \
  > "$NEXT_SQL"

# ── Run tests against next schema (must always pass) ──────────────────────────

echo ""
echo "[compat] Running tests against NEXT schema..."
if ! DATABASE_URL="$DSN_NEXT" go test ./... -count=1 -timeout 60s 2>&1; then
  echo ""
  echo "[compat] FAIL: tests broken against next schema — fix before shipping."
  exit 2
fi
echo "[compat] NEXT schema: OK"

# ── Run tests against current schema (compatibility gate) ─────────────────────

if [ "${SKIP_CURRENT:-false}" = "true" ]; then
  echo "[compat] No current schema to check — assuming compatible (first deploy)."
  echo "compatible" > schema/compat-result.txt
  exit 0
fi

echo ""
echo "[compat] Running tests against CURRENT schema (rolling-deploy gate)..."
if DATABASE_URL="$DSN_CURRENT" go test ./... -count=1 -timeout 60s 2>&1; then
  echo "[compat] CURRENT schema: OK — migration is COMPATIBLE."
  echo "compatible" > schema/compat-result.txt
  exit 0
else
  echo ""
  echo "[compat] CURRENT schema: FAIL — migration is INCOMPATIBLE with old binary."
  echo "[compat] Use: bin/ship --non-compatible-migration"
  echo "incompatible" > schema/compat-result.txt
  exit 1
fi
