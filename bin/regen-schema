#!/usr/bin/env bash
# Spin up an ephemeral Postgres, apply all embedded migrations, pg_dump to schema/shipped.sql.
# Called by `dx merge-train run` after a rebase that adds new migrations.
# Requires: docker running, bin/dx already built (migrations are embedded at compile time).
set -euo pipefail
cd "$(dirname "$0")/.."

PG_IMAGE="postgres:17"
PG_USER="zdx"
PG_PASS="zdx"
PG_DB="zdx"
PORT=17660
CONTAINER="zdx-regen-schema"

cleanup() { docker rm -f "$CONTAINER" 2>/dev/null || true; }
trap cleanup EXIT

docker rm -f "$CONTAINER" 2>/dev/null || true

echo "[regen-schema] starting ephemeral Postgres..."
docker run -d --name "$CONTAINER" \
  -e POSTGRES_USER="$PG_USER" \
  -e POSTGRES_PASSWORD="$PG_PASS" \
  -e POSTGRES_DB="$PG_DB" \
  -p "127.0.0.1:${PORT}:5432" \
  "$PG_IMAGE" >/dev/null

echo "[regen-schema] waiting for Postgres..."
for i in $(seq 1 30); do
  if docker exec "$CONTAINER" pg_isready -U "$PG_USER" -q 2>/dev/null; then break; fi
  sleep 1
  if [ "$i" -eq 30 ]; then
    echo "[regen-schema] ERROR: Postgres did not become ready in 30s"
    exit 1
  fi
done

DSN="postgres://${PG_USER}:${PG_PASS}@localhost:${PORT}/${PG_DB}?sslmode=disable"
echo "[regen-schema] applying migrations..."
DATABASE_URL="$DSN" ./bin/dx migrate up

echo "[regen-schema] dumping schema..."
docker exec "$CONTAINER" \
  pg_dump -U "$PG_USER" -d "$PG_DB" --schema-only --no-owner --no-privileges \
  --exclude-table=schema_migrations \
  | grep -v '^\\' \
  | grep -v '^-- Dumped by pg_dump version' > schema/shipped.sql

echo "[regen-schema] schema/shipped.sql updated."
