#!/usr/bin/env bash
# Rolling deploy via hz-client (Horizon) + systemd.
#
# Usage:
#   bin/ship                        Normal rolling deploy (schema must be compatible)
#   bin/ship --package              Just build deploy/ directory, don't deploy
#   bin/ship --no-package           Skip build, deploy existing package
#   bin/ship --non-compatible-migration
#                                   Maintenance-mode deploy for breaking migrations:
#                                   current goes into maintenance, next gets migrated
#                                   + new code, then current is updated and maintenance
#                                   flag is cleared.
#   bin/ship --no-resume            Refuse to resume a stuck rolling deploy; print
#                                   recovery instructions and exit.
#   bin/ship --allow-dirty          EMERGENCY ONLY — ships uncommitted changes.
#   bin/ship --env <name>           Load home/deploy.<name>.secret.properties
#                                   instead of the default home/deploy.secret.properties.
#                                   Enables targeting a second environment (e.g. staging).
#
# Config: home/deploy.secret.properties (gitignored)
#   deploy.host=ubuntu@192.168.1.89
#   deploy.token=<hz-token>
#   deploy.hz_url=http://hz.office.iodesystems.com
#   deploy.project_slug=<dx project slug>          # optional; enables deploy-record POST
#   deploy.environment_name=<dx environment name>  # optional; enables deploy-record POST
#   deploy.api_url=<https://dx.example.com>        # optional; target dx-server base URL
#   deploy.api_token=<bearer token>                # optional; bearer for the deploy POST
#
# Normal rolling deploy flow (compatible migration):
# 1. Build + package (cross-compile linux/amd64)
# 2. bin/compat-check — verify queries work against current AND next schema
# 3. rolling start   → Horizon takes "next" slot offline
# 4. Deploy next     → rsync dist to next slot
# 5. dx migrate up   → apply migrations (new binary required for embedded migrations)
# 6. Restart next    → start zdx-next, wait for health
# 7. rolling continue → Horizon brings next up, takes "current" offline
# 8. Deploy current  → rsync dist, restart zdx-current
# 9. rolling finalize → both slots serving new code
#
# Maintenance-mode deploy flow (incompatible migration):
# 1. Build + package
# 2. Set MAINTENANCE=true on current slot → restart → shows maintenance page
# 3. Stop next slot
# 4. dx migrate up
# 5. Deploy new binary to next, start next
# 6. Health-check next
# 7. Deploy new binary to current (with MAINTENANCE env removed), restart
# 8. Both slots serving new code, maintenance cleared
set -euo pipefail
cd "$(dirname "$0")/.."

DEPLOY_DIR="deploy"
DEPLOY_PROPS="home/deploy.secret.properties"
PACKAGE_ONLY=false
SKIP_BUILD=false
ALLOW_DIRTY=false
NON_COMPAT=false
NO_RESUME=false
PRINT_SLOT_PATH=false
ENV_NAME=""
BETA=${SHIP_BETA:-true}  # Currently in beta; flip to false when exiting beta
SERVICE="zdx"
REMOTE_HOME="/home/$SERVICE"
MIGRATION_DIR="internal/migrate/sql"

# Preserve original argv for the slot re-exec (the parsing loop below is
# destructive: shift consumes everything once we touch $1).
ORIG_ARGS=("$@")

while [ $# -gt 0 ]; do
  case "$1" in
    --package)                   PACKAGE_ONLY=true ;;
    --no-package)                SKIP_BUILD=true ;;
    --allow-dirty)               ALLOW_DIRTY=true ;;
    --non-compatible-migration)  NON_COMPAT=true ;;
    --no-resume)                 NO_RESUME=true ;;
    --print-slot-path)           PRINT_SLOT_PATH=true ;;
    --env)                       shift; ENV_NAME="$1" ;;
    --env=*)                     ENV_NAME="${1#--env=}" ;;
  esac
  shift
done

if [ -n "$ENV_NAME" ]; then
  DEPLOY_PROPS="home/deploy.${ENV_NAME}.secret.properties"
fi

# ── BETA time gate for --non-compatible-migration ─────────────────────────────
if $NON_COMPAT && ! $BETA; then
  HOUR=${NOW_HOUR:-$(date +%H)}
  DOW=${NOW_DOW:-$(date +%u)}  # 1=Mon, 7=Sun
  if [ "$DOW" -le 5 ] && [ "$HOUR" -ge 9 ] && [ "$HOUR" -lt 18 ]; then
    echo "[ship] REFUSING: --non-compatible-migration is blocked during business hours (weekday 09:00-18:00)."
    echo "[ship] Wait for off-hours or set BETA=true in bin/ship."
    exit 1
  fi
fi

# ── Dirty-tree gate ───────────────────────────────────────────────────────────

IS_DIRTY=false
if ! git diff --quiet || ! git diff --cached --quiet; then
  IS_DIRTY=true
fi

if $IS_DIRTY && ! $ALLOW_DIRTY; then
  echo "[ship] REFUSING TO SHIP: working tree has uncommitted changes."
  echo ""
  git status --short
  echo ""
  echo "[ship] Commit or stash your changes first, then ship."
  echo "[ship] --allow-dirty is a PRODUCTION EMERGENCY ESCAPE HATCH."
  exit 1
fi

# ── Release-branch resolution ─────────────────────────────────────────────────
# Source of truth for release_branch is the server's zdx_environments row, not
# the local properties file. Properties file used to mirror release_branch and
# drifted (see IS-1221). When deploy.environment_name is set in properties,
# query `dx env show <name> --json` for the canonical release_branch.
#
# Fallback: if env_name is unset, or if the server lookup fails (no dx binary,
# server unreachable, env not found), fall back to the legacy
# deploy.release_branch grep. The server path is the authoritative one; the
# legacy grep is opt-in safety only and goes away once all callers migrate
# (planned: IS-1224).
#
# The resolved RELEASE_BRANCH is what we provision the slot from
# (origin/<release_branch>). The old operator-tree branch-mismatch refusal is
# gone — the slot guarantees we ship the canonical branch regardless of what
# branch the operator happens to be on (TK-1805).

RELEASE_BRANCH=""
RELEASE_SOURCE=""

prop_value() { grep "^$1=" "$DEPLOY_PROPS" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true; }

if [ -f "$DEPLOY_PROPS" ]; then
  ENV_FOR_GATE=$(prop_value deploy.environment_name)
  if [ -n "$ENV_FOR_GATE" ] && [ -x ./bin/dx ]; then
    ENV_JSON=$(./bin/dx env show "$ENV_FOR_GATE" --json 2>/dev/null || true)
    if [ -n "$ENV_JSON" ]; then
      RELEASE_BRANCH=$(printf '%s' "$ENV_JSON" | jq -r '.release_branch // empty' 2>/dev/null || true)
      if [ -n "$RELEASE_BRANCH" ]; then
        RELEASE_SOURCE="server"
      fi
    fi
    if [ -z "$RELEASE_BRANCH" ]; then
      echo "[ship] WARN: could not resolve release_branch for env '$ENV_FOR_GATE' from server (falling back to legacy properties grep)."
    fi
  fi

  if [ -z "$RELEASE_BRANCH" ]; then
    RELEASE_BRANCH=$(prop_value deploy.release_branch)
    if [ -n "$RELEASE_BRANCH" ]; then
      RELEASE_SOURCE="properties"
    fi
  fi
fi

# ── Slot provisioning (TK-1805) ───────────────────────────────────────────────
# bin/ship operates against a fresh worktree provisioned from
# origin/<release_branch> rather than the operator's checkout, so half-merged
# trees, stale generated artifacts, and dirty indexes can never leak into a
# deploy. The 2026-05-14 babysit shipped a must-spec gate failure caused by a
# stale host bin/dx; provisioning the slot from origin guarantees the prepare
# phase sees only what's on the canonical branch.
#
# Re-exec strategy: provision the slot, then invoke the slot's own bin/ship
# with the original argv and SHIP_IN_SLOT=1 so the inner invocation skips this
# block. The outer process waits on the inner and removes the slot only on
# success — failures leave the slot in place so an operator can `cd` in and
# inspect.
#
# Skipped when:
#   - SHIP_IN_SLOT=1 (we are the inner re-exec; do not re-provision)
#   - RELEASE_BRANCH is empty (no env config; legacy in-place behavior for
#     fresh repos and operators without a release branch configured)
#   - --no-package: reuse the existing slot (deploy/ from a prior --package
#     run); refuse if the slot doesn't exist.

if [ -z "${SHIP_IN_SLOT:-}" ] && [ -n "$RELEASE_BRANCH" ]; then
  # Resolve project slug from .zdx/config.yaml (under remote: or project:),
  # fall back to the repo basename. Slug scopes the slot path so two checkouts
  # of the same repo don't fight over one slot.
  SLUG=""
  if [ -f .zdx/config.yaml ]; then
    SLUG=$(awk '
      /^[^[:space:]#]/ { in_target = 0 }
      /^(remote|project):[[:space:]]*$/ { in_target = 1; next }
      in_target && /^[[:space:]]+slug:[[:space:]]*/ {
        sub(/^[[:space:]]+slug:[[:space:]]*/, "")
        gsub(/[[:space:]]/, "")
        print; exit
      }
    ' .zdx/config.yaml)
  fi
  [ -z "$SLUG" ] && SLUG=$(basename "$PWD")

  SLOT_BASE="${SHIP_SLOT_BASE:-$HOME/.zdx/projects}"
  SLOT="${SLOT_BASE}/${SLUG}/ship-slot"

  if $SKIP_BUILD; then
    if [ ! -d "$SLOT" ]; then
      echo "[ship] ERROR: --no-package requires an existing slot at $SLOT"
      echo "[ship] Run 'bin/ship --package' first, or drop --no-package for a fresh build."
      exit 1
    fi
    echo "[ship] Reusing existing slot: $SLOT"
    # Refresh the props file so ENV_NAME / api token changes propagate.
    if [ -f "$DEPLOY_PROPS" ]; then
      mkdir -p "$SLOT/$(dirname "$DEPLOY_PROPS")"
      cp "$DEPLOY_PROPS" "$SLOT/$DEPLOY_PROPS"
    fi
  else
    echo "[ship] Provisioning slot worktree: $SLOT (from origin/$RELEASE_BRANCH)"
    # Idempotent: a prior failed slot may exist as a registered worktree, an
    # untracked directory, or both. Detach and rm covers all cases.
    if [ -e "$SLOT" ] || git worktree list --porcelain 2>/dev/null | grep -qF "worktree $SLOT"; then
      git worktree remove --force "$SLOT" 2>/dev/null || true
      rm -rf "$SLOT"
    fi
    mkdir -p "$(dirname "$SLOT")"
    git fetch --quiet origin "$RELEASE_BRANCH"
    git worktree add --quiet --detach "$SLOT" "origin/$RELEASE_BRANCH"

    # Properties file is gitignored, so the fresh slot doesn't have it. T3
    # (depends on IS-1221 landing) will remove this copy in favor of an
    # env-driven config path.
    if [ -f "$DEPLOY_PROPS" ]; then
      mkdir -p "$SLOT/$(dirname "$DEPLOY_PROPS")"
      cp "$DEPLOY_PROPS" "$SLOT/$DEPLOY_PROPS"
    fi
  fi

  if $PRINT_SLOT_PATH; then
    echo "$SLOT"
    exit 0
  fi

  echo "[ship] Re-executing in slot: $SLOT"
  set +e
  SHIP_IN_SLOT=1 bash "$SLOT/bin/ship" "${ORIG_ARGS[@]}"
  SLOT_RC=$?
  set -e
  if [ $SLOT_RC -eq 0 ]; then
    git worktree remove --force "$SLOT" 2>/dev/null || true
    rm -rf "$SLOT"
    echo "[ship] Slot cleaned up."
    exit 0
  else
    echo "[ship] FAILED — slot preserved for inspection: $SLOT"
    exit $SLOT_RC
  fi
fi

# ── Dev-image toolchain isolation (TK-1806) ───────────────────────────────────
# Pin the prepare-phase toolchain (Go, node/pnpm, sqlc) to the dev image so
# `bin/ship` doesn't pick up whatever stale `dx` / `go` / `pnpm` happens to be
# on the operator's $PATH. The 2026-05-14 babysit shipped a must-spec gate
# failure caused by a stale host bin/dx; using the image's toolchain removes
# that failure mode.
#
# Image tag is content-addressed by the SHA of dev.Dockerfile (matches the
# pattern in internal/cli/agent/container.go) so a Dockerfile edit forces a
# rebuild, and unchanged Dockerfiles reuse the cached image.
#
# Container is launched with:
#   --network host          dx CLI reaches the dev-server on localhost; compat-check
#                           binds postgres on 127.0.0.1:<port> and we hit it back.
#   docker.sock mount       compat-check spawns sibling postgres containers via
#                           `docker run` and tears them down with `docker rm`.
#   --group-add docker-gid  the image's `agent` user (UID 1000) needs the host's
#                           docker GID as a supplementary group to read the socket.
#   PWD bind mount          the operator's source tree becomes /workspace; once
#                           TK-1805 lands the slot worktree is bind-mounted here
#                           instead, with no further changes to this wrapper.

IMAGE_TAG=""
USE_DEV_IMAGE=true

# Decide once whether the prepare phase can be containerized. Requires both
# `docker` on PATH and a `dev.Dockerfile` in the repo. When either is missing
# we fall back to running the prepare commands on the host so script-level
# tests in temp repos (and emergency operator runs from a stripped host) keep
# working — at the cost of toolchain isolation. The warning is logged once so
# operators can see they lost isolation.
if ! command -v docker >/dev/null 2>&1 || [ ! -f dev.Dockerfile ]; then
  USE_DEV_IMAGE=false
fi

ensure_dev_image() {
  [ -n "$IMAGE_TAG" ] && return 0
  if ! $USE_DEV_IMAGE; then
    return 0
  fi
  local digest
  digest=$(sha256sum dev.Dockerfile | cut -c1-16)
  IMAGE_TAG="zdx-agent:${digest}"
  if docker image inspect "$IMAGE_TAG" >/dev/null 2>&1; then
    echo "[ship] dev image $IMAGE_TAG up-to-date"
    return 0
  fi
  echo "[ship] Building dev image $IMAGE_TAG from dev.Dockerfile..."
  docker build -f dev.Dockerfile -t "$IMAGE_TAG" . >&2
}

DOCKER_SOCK_GID=""
docker_sock_gid() {
  if [ -z "$DOCKER_SOCK_GID" ] && [ -S /var/run/docker.sock ]; then
    DOCKER_SOCK_GID=$(stat -c %g /var/run/docker.sock 2>/dev/null || true)
  fi
  printf '%s' "$DOCKER_SOCK_GID"
}

# in_container <argv...>
# Runs <argv> inside the dev image with the operator's worktree bind-mounted
# at /workspace. stdout/stderr are passed through so callers can capture them
# with the usual `> file 2>&1` redirection (e.g. the must-spec gate dedup
# logic captures gate output for blocker-issue filing).
#
# When USE_DEV_IMAGE=false (no docker on PATH or no dev.Dockerfile), runs
# <argv> directly on the host instead — degrades gracefully for stripped
# test environments at the cost of toolchain isolation.
in_container() {
  if ! $USE_DEV_IMAGE; then
    "$@"
    return $?
  fi
  ensure_dev_image
  local docker_args=(
    docker run --rm
    --network host
    -v "$PWD:/workspace"
    -w /workspace
    -e GIT_CONFIG_COUNT=1
    -e GIT_CONFIG_KEY_0=safe.directory
    -e GIT_CONFIG_VALUE_0='*'
  )
  local sock_gid
  sock_gid=$(docker_sock_gid)
  if [ -n "$sock_gid" ]; then
    docker_args+=(-v /var/run/docker.sock:/var/run/docker.sock --group-add "$sock_gid")
  fi
  docker_args+=("$IMAGE_TAG" "$@")
  "${docker_args[@]}"
}

# ── Config loader ─────────────────────────────────────────────────────────────

load_deploy_config() {
  if [ ! -f "$DEPLOY_PROPS" ]; then
    echo "[ship] Missing $DEPLOY_PROPS. Create it:"
    echo "  deploy.host=ubuntu@192.168.1.89"
    echo "  deploy.token=<hz-token>"
    echo "  deploy.hz_url=http://hz.office.iodesystems.com"
    exit 1
  fi

  prop() { grep "^$1=" "$DEPLOY_PROPS" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true; }

  HOST=$(prop deploy.host)
  export HZ_TOKEN=$(prop deploy.token)
  export HZ_URL=$(prop deploy.hz_url)
  RSYNC_PATH="sudo -u $SERVICE rsync"

  # Optional: deploy-record POST to a dx-server. Missing keys → warn-and-skip in
  # post_deploy_record so --package and partial configs keep working.
  DEPLOY_PROJECT_SLUG=$(prop deploy.project_slug)
  DEPLOY_ENV_NAME=$(prop deploy.environment_name)
  DEPLOY_API_URL=$(prop deploy.api_url)
  DEPLOY_API_TOKEN=$(prop deploy.api_token)
  # Fall back to .zdx/credentials (project API key) when deploy.api_token unset.
  [ -z "$DEPLOY_API_TOKEN" ] && [ -f .zdx/credentials ] && DEPLOY_API_TOKEN=$(cat .zdx/credentials | tr -d '[:space:]')

  [ -z "$HOST" ]     && echo "[ship] Missing deploy.host"   && exit 1
  [ -z "$HZ_TOKEN" ] && echo "[ship] Missing deploy.token"  && exit 1
  [ -z "$HZ_URL" ]   && echo "[ship] Missing deploy.hz_url" && exit 1

  if [ ! -f infra/hz-client ]; then
    echo "[ship] ERROR: infra/hz-client not found"
    exit 1
  fi
  HZ="./infra/hz-client --timeout 60"
}

# ── Lint gate ─────────────────────────────────────────────────────────────────
# Refuse to ship if the tree has generator drift (sqlc-drift, openapi-drift,
# tsc, gofmt, etc). Close hooks run lint on issue/task close, but plain commits
# (notably the post-ship shipped.sql update) bypass them — without this gate,
# drift introduced by one ship sits in main until the next agent's `dev done`
# regenerates and finds their build broken by unrelated work (see IS-475).

if ! $SKIP_BUILD || ! $NON_COMPAT; then
  # Either the build phases or compat-check will be exercised — prepare the
  # dev image once so subsequent echoes can reference its tag. When
  # USE_DEV_IMAGE=false (no docker / no Dockerfile) ensure_dev_image is a
  # no-op and the prepare phases run on the host (toolchain not isolated).
  if $USE_DEV_IMAGE; then
    echo "[ship] Preparing dev image (toolchain isolation)..."
    ensure_dev_image
  else
    echo "[ship] WARNING: docker or dev.Dockerfile missing — running prepare phase on host (no toolchain isolation)"
  fi
fi

if ! $SKIP_BUILD; then
  if $USE_DEV_IMAGE; then
    echo "[ship] Running lint (in $IMAGE_TAG)..."
  else
    echo "[ship] Running lint..."
  fi
  if ! in_container ./bin/lint; then
    echo "[ship] REFUSING TO SHIP: lint failed."
    echo "[ship] Fix the failing checks above (or run ./bin/db gen / ./bin/dx ui gen-api for drift)."
    exit 1
  fi
fi

# ── Must-spec gate ────────────────────────────────────────────────────────────
# Block deploy on must-tier spec demo failures. When on the release branch,
# auto-file (or update) a blocker issue so regressions are tracked rather
# than silently retried by the next ship attempt.
#
# Dedup: each ship-retry on the same release branch would otherwise file a
# fresh duplicate of the same blocker (we observed IS-1217/IS-1218/IS-1219/
# IS-1220 — four identical tickets in one session). Before filing, look for
# an already-open issue with the canonical title; if found, comment on it
# with the current attempt's gate output instead of spawning a new one. The
# title format is the stable dedup key.

if ! $SKIP_BUILD; then
  if $USE_DEV_IMAGE; then
    echo "[ship] Checking must-spec demos (in $IMAGE_TAG)..."
  else
    echo "[ship] Checking must-spec demos..."
  fi
  GATE_OUT=$(mktemp)
  if ! in_container ./bin/dx ship gate > "$GATE_OUT" 2>&1; then
    cat "$GATE_OUT"
    if [ -n "$RELEASE_BRANCH" ]; then
      GATE_TITLE="ship blocked: must-spec demo gaps on ${RELEASE_BRANCH}"
      # `dx issue list --status=open` lines look like:
      #   IS-1217  open                           ship blocked: must-spec demo gaps on main
      # Two-space gap between status and title is the only reliable column
      # boundary; grep for the literal title suffix to dedup. awk pulls the
      # first column (the IS-N id).
      EXISTING=$(./bin/dx issue list --status=open 2>/dev/null \
        | grep -F "  ${GATE_TITLE}" \
        | awk '{print $1}' \
        | head -1 || true)
      if [ -n "$EXISTING" ]; then
        # Reuse: add a retry note rather than file a new ticket. The
        # commit SHA stamps which build saw the gate fail this time, so
        # subsequent reviewers can see how many retries landed against
        # one ticket.
        ./bin/dx comment add issue "$EXISTING" \
          --body="ship gate failed again on $(date -u +%Y-%m-%dT%H:%M:%SZ) at $(git rev-parse --short HEAD):

$(cat "$GATE_OUT")" >/dev/null 2>&1 || true
        echo "[ship] Reusing existing blocker: $EXISTING (added gate-retry comment)"
      else
        FILED=$(./bin/dx issue add \
          --title="$GATE_TITLE" \
          --type=impl \
          --auto-ready \
          --context="$(cat "$GATE_OUT")" 2>&1 | grep -oE 'IS-[0-9]+' | head -1 || true)
        [ -n "$FILED" ] && echo "[ship] Filed blocker issue: $FILED"
      fi
    fi
    rm -f "$GATE_OUT"
    echo "[ship] REFUSING TO SHIP: must-spec gate failed."
    exit 1
  fi
  cat "$GATE_OUT"
  rm -f "$GATE_OUT"
fi

# ── Build ─────────────────────────────────────────────────────────────────────

if ! $SKIP_BUILD; then
  if $USE_DEV_IMAGE; then
    echo "[ship] Building dx-server + dx + UI (in $IMAGE_TAG)..."
  else
    echo "[ship] Building dx-server + dx + UI..."
  fi
  # Run cross-compile and UI build inside the dev image so the deploy artifact
  # is produced by the pinned toolchain (Go 1.25, node 20, pnpm) regardless of
  # what the operator has on $PATH. Output lands in the bind-mounted slot at
  # $DEPLOY_DIR/dist/ (visible on the host).
  in_container bash -c '
    set -euo pipefail
    SHA=$(git rev-parse --short HEAD)
    echo "[ship/in-container] Building dx-server (linux/amd64, static)..."
    GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
      go build -trimpath -ldflags="-s -w -X main.version=${SHA} -X main.buildSHA=${SHA}" \
      -o "'"$DEPLOY_DIR"'/dist/dx-server" ./cmd/dx-server

    echo "[ship/in-container] Building dx (linux/amd64)..."
    GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
      go build -trimpath -ldflags="-s -w" \
      -o "'"$DEPLOY_DIR"'/dist/dx" ./cmd/dx

    UI_HASH=$(git ls-files ui/ | grep -v "^ui/dist/" | xargs -d"\n" sha256sum 2>/dev/null | sha256sum | cut -d" " -f1)
    UI_HASH_FILE="ui/dist/.build-hash"
    if [ -f "$UI_HASH_FILE" ] && [ "$(cat "$UI_HASH_FILE")" = "$UI_HASH" ] && [ -d "ui/dist/assets" ]; then
      echo "[ship/in-container] UI unchanged (${UI_HASH:0:8}) — skipping rebuild."
    else
      echo "[ship/in-container] Building UI..."
      (cd ui && pnpm install --frozen-lockfile && pnpm run build 2>&1 | tail -3)
      echo "$UI_HASH" > "$UI_HASH_FILE"
    fi
  '

  mkdir -p "$DEPLOY_DIR/dist/public"
  [ -d ui/dist ] && cp -r ui/dist/* "$DEPLOY_DIR/dist/public/"
  # Idempotent: if $DEPLOY_DIR/provision already exists, cp -r would create a
  # nested provision/ subdirectory instead of refreshing the files.
  rm -rf "$DEPLOY_DIR/provision"
  cp -r infra/provision "$DEPLOY_DIR/provision"
  # Package migration fix scripts so ops can read/run them on the host.
  MIG_FIXES_SRC="$MIGRATION_DIR/migration-fixes"
  if [ -d "$MIG_FIXES_SRC" ] && [ -n "$(ls -A "$MIG_FIXES_SRC" 2>/dev/null)" ]; then
    mkdir -p "$DEPLOY_DIR/dist/migration-fixes"
    cp "$MIG_FIXES_SRC"/*.sql "$DEPLOY_DIR/dist/migration-fixes/"
  fi

  cat > "$DEPLOY_DIR/manifest.txt" <<EOF
commit: $(git rev-parse HEAD)
branch: $(git rev-parse --abbrev-ref HEAD)
date:   $(date -u +"%Y-%m-%dT%H:%M:%SZ")
dirty:  $(if $IS_DIRTY; then echo "yes"; else echo "no"; fi)
EOF

  if $PACKAGE_ONLY; then
    echo "[ship] Package complete."
    cat "$DEPLOY_DIR/manifest.txt"
    ls -lh "$DEPLOY_DIR/dist/"
    exit 0
  fi
else
  [ ! -f "$DEPLOY_DIR/dist/dx-server" ] && \
    echo "[ship] ERROR: no dx-server in deploy/ — run without --no-package first" && exit 1
fi

load_deploy_config

# ── Deploy-record context ─────────────────────────────────────────────────────
# Capture start time, deploy SHA, and stdout/stderr so post_deploy_record can
# include duration_secs + log in the POST body. SHIP_START is the wall-clock at
# deploy-config load (excludes lint/build/compat-check, which is what operators
# care about as "how long did the deploy itself take").

SHIP_START=$(date +%s)
SHIP_LOG_FILE=$(mktemp -t zdx-ship-log.XXXXXX)
DEPLOYED_GIT_HASH=$(git rev-parse HEAD)
$IS_DIRTY && DEPLOYED_GIT_HASH="${DEPLOYED_GIT_HASH}-dirty"

# Mirror everything from here on into SHIP_LOG_FILE. The original stdout/stderr
# still go to the terminal (tee), and the file is what gets POSTed.
exec > >(tee -a "$SHIP_LOG_FILE") 2>&1

post_deploy_record() {
  if [ -z "$DEPLOY_API_URL" ] || [ -z "$DEPLOY_PROJECT_SLUG" ] || [ -z "$DEPLOY_ENV_NAME" ]; then
    echo "[ship] WARN: deploy.api_url/project_slug/environment_name missing — skipping deploy record POST."
    return 0
  fi
  local duration_secs=$(( $(date +%s) - SHIP_START ))
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD)
  local log_content
  log_content=$(cat "$SHIP_LOG_FILE" 2>/dev/null || echo "")
  local body
  body=$(jq -n \
    --arg sha "$DEPLOYED_GIT_HASH" \
    --arg branch "$branch" \
    --argjson duration "$duration_secs" \
    --arg log "$log_content" \
    '{build_sha: $sha, build_branch: $branch, status: "success", duration_secs: $duration, log: $log}')
  local auth_header=()
  [ -n "$DEPLOY_API_TOKEN" ] && auth_header=(-H "X-Api-Key: $DEPLOY_API_TOKEN")
  if curl -sf -X POST \
    "${auth_header[@]}" \
    -H "Content-Type: application/json" \
    -d "$body" \
    "$DEPLOY_API_URL/api/dx/projects/$DEPLOY_PROJECT_SLUG/environments/$DEPLOY_ENV_NAME/deploys" >/dev/null; then
    echo "[ship] Deploy record posted (env=$DEPLOY_ENV_NAME, sha=${DEPLOYED_GIT_HASH:0:12}, duration=${duration_secs}s)."
  else
    echo "[ship] WARN: deploy record POST failed (deploy itself succeeded)."
  fi
}

# ── Validate migration history unchanged ──────────────────────────────────────
#
# Pure renames (identical content, different name) are allowed: golang-migrate
# resolves migrations by numeric prefix, not filename.
#
# Renamed+modified or in-place modifications are allowed when a fix file exists:
#
#   internal/migrate/sql/migration-fixes/<deployed-name-no-ext>-<server8>-<dev8>.sql
#
#   server8  = first 8 chars of sha256 of the deployed file content
#   dev8     = first 8 chars of sha256 of the local replacement file's content
#              (or "none" for a deleted file with no local equivalent)
#
# Fix files are packaged into deploy/dist/migration-fixes/ and rsync'd to the
# host so ops can inspect and run them after deploy if needed.

echo "[ship] Validating migration history..."

DEPLOYED_COMMIT=$(ssh "$HOST" "cat $REMOTE_HOME/home/shipped-commit 2>/dev/null" || echo "")
PENDING_FIXES=()
MIG_FIXES="$MIGRATION_DIR/migration-fixes"

if [ -n "$DEPLOYED_COMMIT" ]; then
  DEPLOYED_COMMIT_CLEAN="${DEPLOYED_COMMIT%-dirty}"
  MODIFIED=0

  # Build content-hash → basename index for rename detection
  declare -A LOCAL_HASH_TO_FILE
  for lf in "$MIGRATION_DIR"/*.sql; do
    [ -f "$lf" ] || continue
    h=$(sha256sum "$lf" | cut -d' ' -f1)
    LOCAL_HASH_TO_FILE["$h"]=$(basename "$lf")
  done

  while IFS= read -r mig; do
    SHIPPED_HASH=$(git show "$DEPLOYED_COMMIT_CLEAN:$MIGRATION_DIR/$mig" | sha256sum | cut -d' ' -f1)
    SERVER8="${SHIPPED_HASH:0:8}"
    BASE="${mig%.sql}"
    LOCAL_FILE="$MIGRATION_DIR/$mig"

    if [ ! -f "$LOCAL_FILE" ]; then
      # Pure rename: same content, different name
      if [[ -n "${LOCAL_HASH_TO_FILE[$SHIPPED_HASH]+x}" ]]; then
        echo "[ship] NOTE: migration RENAMED: $mig → ${LOCAL_HASH_TO_FILE[$SHIPPED_HASH]} (OK)"
        continue
      fi
      # Renamed + modified: look for fix file with matching server8
      FIX=$(ls "$MIG_FIXES/${BASE}-${SERVER8}-"*.sql 2>/dev/null | head -1)
      if [ -n "$FIX" ]; then
        echo "[ship] NOTE: migration RENAMED+MODIFIED (fix acknowledged): $mig — $(basename "$FIX")"
        PENDING_FIXES+=("$FIX")
      else
        echo "[ship] ERROR: shipped migration missing locally (not a rename): $mig"
        echo "[ship]   create: $MIG_FIXES/${BASE}-${SERVER8}-<dev8>.sql"
        MODIFIED=1
      fi
      continue
    fi

    LOCAL_HASH=$(sha256sum "$LOCAL_FILE" | cut -d' ' -f1)
    if [ "$SHIPPED_HASH" != "$LOCAL_HASH" ]; then
      DEV8="${LOCAL_HASH:0:8}"
      FIX="$MIG_FIXES/${BASE}-${SERVER8}-${DEV8}.sql"
      if [ -f "$FIX" ]; then
        echo "[ship] NOTE: migration MODIFIED (fix acknowledged): $mig — $(basename "$FIX")"
        PENDING_FIXES+=("$FIX")
      else
        echo "[ship] ERROR: shipped migration MODIFIED: $mig"
        echo "[ship]   create: $FIX"
        MODIFIED=1
      fi
    fi
  done < <(git ls-tree --name-only "$DEPLOYED_COMMIT_CLEAN" "$MIGRATION_DIR/" 2>/dev/null | xargs -I{} basename {})

  [ "$MODIFIED" -ne 0 ] && \
    echo "[ship] REFUSING: shipped migrations modified — create a new migration instead." && exit 1
  echo "[ship] Migration history OK."
else
  echo "[ship] No deployed commit — first deploy, skipping history check."
fi

# ── Schema compatibility check ────────────────────────────────────────────────

if ! $NON_COMPAT; then
  if $USE_DEV_IMAGE; then
    echo "[ship] Running schema compatibility check (in $IMAGE_TAG)..."
  else
    echo "[ship] Running schema compatibility check..."
  fi
  # compat-check spawns ephemeral sibling postgres containers via docker.sock
  # (mounted into in_container) and connects to them on 127.0.0.1:<port>,
  # which resolves to the same host network because the container runs
  # --network host. pg_dump (via `docker exec`) and go test run inside the
  # dev image's pinned toolchain.
  set +e
  in_container ./bin/dx ship compat-check
  COMPAT_EXIT=$?
  set -e

  if [ $COMPAT_EXIT -eq 2 ]; then
    echo "[ship] FAIL: test suite broken — fix before shipping."
    exit 1
  fi

  if [ $COMPAT_EXIT -eq 1 ]; then
    echo ""
    echo "[ship] Migration is INCOMPATIBLE with the currently-deployed binary."
    echo ""
    echo "  (a) File an ops issue for a scheduled maintenance-window ship."
    echo "  (b) Ship now with maintenance mode: bin/ship --non-compatible-migration"
    echo ""
    exit 1
  fi

  echo "[ship] Schema compatibility: OK"
else
  echo "[ship] Skipping compat check (--non-compatible-migration)."
  echo "[ship] Will use maintenance-mode deploy."
fi

# ── Deploy helpers ────────────────────────────────────────────────────────────

run_migrate() {
  local slot="$1"
  local unit="${SERVICE}-${slot}"
  local binary="${REMOTE_HOME}/home/versions/${slot}/dx"
  # Pipe a script to bash over SSH to avoid quote nesting entirely.
  ssh "$HOST" "sudo -u $SERVICE bash -s" <<REMOTESCRIPT
DATABASE_URL=\$(systemctl show ${unit} --property=Environment \
  | sed 's/^Environment=//' | tr -d '"' | tr ' ' '\n' \
  | grep '^DATABASE_URL=' | head -1 | cut -d= -f2-)
export DATABASE_URL
${binary} migrate up
REMOTESCRIPT
}

sync_slot() {
  local slot="$1"
  rsync -az --delete --rsync-path="$RSYNC_PATH" \
    "$DEPLOY_DIR/dist/" "$HOST:$REMOTE_HOME/home/versions/$slot/"
  rsync -az --rsync-path="$RSYNC_PATH" \
    "$DEPLOY_DIR/provision/" "$HOST:$REMOTE_HOME/home/provision/"
  ssh "$HOST" "sudo SKIP_SERVICE_START=true bash $REMOTE_HOME/home/provision/provision.sh"
}

set_maintenance() {
  local slot="$1" val="$2"
  # Write/remove a systemd override that sets MAINTENANCE=true for the slot.
  local unit="${SERVICE}-${slot}"
  local override_dir="/etc/systemd/system/${unit}.service.d"
  if [ "$val" = "true" ]; then
    ssh "$HOST" "sudo bash -c \"
      mkdir -p $override_dir
      printf '[Service]\nEnvironment=MAINTENANCE=true\n' > $override_dir/maintenance.conf
      systemctl daemon-reload
      systemctl restart $unit\""
    echo "[ship] Maintenance mode ON for $slot."
  else
    ssh "$HOST" "sudo bash -c \"
      rm -f $override_dir/maintenance.conf
      systemctl daemon-reload\""
    echo "[ship] Maintenance mode OFF for $slot."
  fi
}

wait_health() {
  local port="$1" label="$2"
  for i in $(seq 1 20); do
    if ssh "$HOST" "curl -sf http://localhost:${port}/api/health >/dev/null 2>&1"; then
      echo "[ship] $label healthy on :$port"
      return
    fi
    sleep 2
  done
  echo "[ship] ERROR: $label did not become healthy on :$port"
  exit 1
}

# ── Initial provision ─────────────────────────────────────────────────────────

echo "[ship] Initial provision..."
rsync -az "$DEPLOY_DIR/provision/" "$HOST:/tmp/zdx-provision/"
ssh "$HOST" "sudo SKIP_SERVICE_START=true bash /tmp/zdx-provision/provision.sh"
# Pre-create (and, if root-owned from a prior run, repair) the rsync target
# so sudo-as-zdx rsync can write into it.
ssh "$HOST" "sudo install -d -o $SERVICE -g $SERVICE $REMOTE_HOME/home/provision"
rsync -az --rsync-path="$RSYNC_PATH" \
  "$DEPLOY_DIR/provision/" "$HOST:$REMOTE_HOME/home/provision/"

# ── Rolling deploy (compatible migration) ─────────────────────────────────────
#
# The deploy has three commit points. After each hz-client transition, bin/ship
# may be interrupted (SIGINT, SSH failure, etc.) leaving Horizon in a non-idle
# phase. Re-running bin/ship detects the phase via 'hz-client rolling status'
# and resumes from there instead of failing at 'rolling start'.
#
#   idle         → full flow (start → deploy-next → continue → deploy-current → finalize)
#   next-down    → resume at deploy-next (skip 'start')
#   current-down → resume at deploy-current (skip 'start' and 'continue')

deploy_next() {
  echo "[ship] Deploying next..."
  sync_slot next

  if [ ${#PENDING_FIXES[@]} -gt 0 ]; then
    echo "[ship] NOTE: migration fix files packaged — ops should review and run if needed:"
    for fix in "${PENDING_FIXES[@]}"; do
      echo "[ship]   $REMOTE_HOME/home/versions/next/migration-fixes/$(basename "$fix")"
    done
  fi

  echo "[ship] Running migrations (before starting new binary)..."
  run_migrate next

  ssh "$HOST" "sudo systemctl restart ${SERVICE}-next"
  wait_health 7602 "next"
}

deploy_current() {
  echo "[ship] Deploying current..."
  sync_slot current
  ssh "$HOST" "sudo systemctl restart ${SERVICE}-current"
  wait_health 7600 "current"
}

if ! $NON_COMPAT; then
  echo ""
  echo "=== Rolling deploy ==="
  $HZ status
  echo ""

  PHASE=$($HZ rolling status 2>/dev/null | awk -F': ' '/^Rolling phase:/ {print $2; exit}')
  [ -z "$PHASE" ] && PHASE="unknown"
  echo "[ship] Current rolling phase: $PHASE"

  case "$PHASE" in
    idle)
      : # fresh deploy — fall through
      ;;
    next-down|current-down)
      if $NO_RESUME; then
        echo ""
        echo "[ship] REFUSING: rolling deploy is in phase '$PHASE' and --no-resume was given."
        echo ""
        echo "  To resume automatically:  bin/ship                  (re-runs from phase $PHASE)"
        echo "  To inspect state:         infra/hz-client rolling status"
        echo "  To reset manually:"
        case "$PHASE" in
          next-down)
            echo "    infra/hz-client next up         # restore next without deploying"
            ;;
          current-down)
            echo "    infra/hz-client rolling finalize  # bring current back up"
            ;;
        esac
        exit 1
      fi
      echo "[ship] Resuming deploy from phase: $PHASE"
      ;;
    draining-next|draining-current)
      echo ""
      echo "[ship] REFUSING: rolling deploy is mid-transition (phase: $PHASE)."
      echo "[ship] Wait for the drain to finish, then re-run. Use 'infra/hz-client rolling status' to watch."
      exit 1
      ;;
    *)
      echo ""
      echo "[ship] REFUSING: unrecognized rolling phase '$PHASE'."
      echo "[ship] Run 'infra/hz-client rolling status' and 'infra/hz-client status' to inspect, then:"
      echo "[ship]   - return both slots to 'up' (idle) before retrying, or"
      echo "[ship]   - drive the remaining hz-client transitions manually."
      exit 1
      ;;
  esac

  case "$PHASE" in
    idle)
      echo "[ship] Phase 1: rolling start (next goes offline)..."
      $HZ rolling start
      deploy_next
      echo "[ship] Phase 2: rolling continue (current goes offline)..."
      $HZ rolling continue
      deploy_current
      echo "[ship] Phase 3: rolling finalize..."
      $HZ rolling finalize
      post_deploy_record
      ;;
    next-down)
      deploy_next
      echo "[ship] Phase 2: rolling continue (current goes offline)..."
      $HZ rolling continue
      deploy_current
      echo "[ship] Phase 3: rolling finalize..."
      $HZ rolling finalize
      post_deploy_record
      ;;
    current-down)
      deploy_current
      echo "[ship] Phase 3: rolling finalize..."
      $HZ rolling finalize
      post_deploy_record
      ;;
  esac

# ── Maintenance-mode deploy (incompatible migration) ─────────────────────────

else
  echo ""
  echo "=== Maintenance-mode deploy ==="
  echo ""

  # 1. Put current into maintenance, keep it serving the maintenance page.
  echo "[ship] Enabling maintenance mode on current..."
  set_maintenance current true
  wait_health 7600 "current (maintenance)"

  # 2. Stop next cleanly.
  echo "[ship] Stopping next..."
  ssh "$HOST" "sudo systemctl stop ${SERVICE}-next 2>/dev/null || true"

  # 3. Run migrations — no binary is running new code yet.
  echo "[ship] Running migrations..."
  # Ship the dx binary to next's slot first so we can invoke it.
  rsync -az --delete --rsync-path="$RSYNC_PATH" \
    "$DEPLOY_DIR/dist/" "$HOST:$REMOTE_HOME/home/versions/next/"

  if [ ${#PENDING_FIXES[@]} -gt 0 ]; then
    echo "[ship] NOTE: migration fix files packaged — ops should review and run if needed:"
    for fix in "${PENDING_FIXES[@]}"; do
      echo "[ship]   $REMOTE_HOME/home/versions/next/migration-fixes/$(basename "$fix")"
    done
  fi

  run_migrate next
  echo "[ship] Migrations complete."

  # 4. Start next with new code.
  echo "[ship] Starting next with new code..."
  ssh "$HOST" "sudo systemctl restart ${SERVICE}-next"
  wait_health 7602 "next"

  # 5. Stop current (still serving maintenance page), deploy new code, clear flag.
  echo "[ship] Deploying new code to current, clearing maintenance..."
  ssh "$HOST" "sudo systemctl stop ${SERVICE}-current 2>/dev/null || true"
  sync_slot current
  set_maintenance current false
  ssh "$HOST" "sudo systemctl restart ${SERVICE}-current"
  wait_health 7600 "current"

  echo "[ship] Both slots serving new code, maintenance cleared."
  post_deploy_record
fi

# ── Verify and record ─────────────────────────────────────────────────────────

# DEPLOYED_GIT_HASH was computed early (before the deploy phases) so
# post_deploy_record can include it in its POST body.
ssh "$HOST" "sudo -u $SERVICE bash -c \"echo '$DEPLOYED_GIT_HASH' > $REMOTE_HOME/home/shipped-commit\""
echo "[ship] Deployed commit: $DEPLOYED_GIT_HASH"

# Finalize: dump live schema to shipped.sql, regen sqlc, validate coverage.
# Shared with the harness's finalize stages — see bin/post-deploy-finalize.
# Live-DB pg_dump (vs cp from schema/next.sql) catches drift introduced by
# out-of-band schema mods that next.sql wouldn't see.
./bin/post-deploy-finalize promote-shipped
./bin/post-deploy-finalize regen-sqlc
./bin/post-deploy-finalize validate-coverage

# ── Install dx locally ────────────────────────────────────────────────────────

if [ -d "$HOME/local/bin" ]; then
  echo "[ship] Installing dx to ~/local/bin/dx..."
  go build -trimpath -ldflags="-s -w" -o "$HOME/local/bin/dx" ./cmd/dx
  echo "[ship] dx installed."
fi

echo ""
echo "[ship] Done."
$HZ status 2>/dev/null || true
