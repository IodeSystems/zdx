#!/usr/bin/env bash
# Parallel lint runner with sqlc drift check.
set -euo pipefail
cd "$(dirname "$0")/.."

FAIL=0
PIDS=()
LABELS=()
LOGS_DIR=$(mktemp -d)
trap 'rm -rf "$LOGS_DIR"' EXIT

run() {
  local label="$1"; shift
  (
    set +e
    t0=$(date +%s%N)
    "$@" > "$LOGS_DIR/$label.out" 2>&1
    rc=$?
    t1=$(date +%s%N)
    awk -v t0="$t0" -v t1="$t1" 'BEGIN { printf "%.1fs", (t1 - t0) / 1e9 }' > "$LOGS_DIR/$label.dur"
    exit $rc
  ) &
  PIDS+=($!)
  LABELS+=("$label")
}

elapsed() {
  cat "$LOGS_DIR/$1.dur" 2>/dev/null || echo "?"
}

# ── Parallel lint jobs ────────────────────────────────────────────────────────

run "gofmt" bash -c '
  BAD=$(gofmt -l .)
  if [ -n "$BAD" ]; then
    echo "gofmt: files need formatting:"
    echo "$BAD"
    exit 1
  fi
'

run "govet" go vet ./...

run "sqlcvet" bash -c '
  SQLC=$(command -v sqlc || echo "$HOME/go/bin/sqlc")
  "$SQLC" vet
'

run "tsc" bash -c 'cd ui && pnpm exec tsc --noEmit'

run "eslint" bash -c 'cd ui && pnpm run lint'

run "knip" bash -c 'cd ui && pnpm run lint:knip'

run "sqlc-drift" bash -c '
  SQLC=$(command -v sqlc || echo "$HOME/go/bin/sqlc")
  TMPDIR=$(mktemp -d)
  trap "rm -rf $TMPDIR" EXIT
  cp sqlc.yaml "$TMPDIR/sqlc.yaml"
  ln -s "$(pwd)/schema" "$TMPDIR/schema"
  ln -s "$(pwd)/queries" "$TMPDIR/queries"
  sed -i "s|out: \"internal/db\"|out: \"db\"|" "$TMPDIR/sqlc.yaml"
  "$SQLC" generate -f "$TMPDIR/sqlc.yaml"
  if ! diff -rq --exclude=queries.go internal/db "$TMPDIR/db" >/dev/null 2>&1; then
    echo "sqlc drift detected — committed internal/db/ does not match generated output."
    echo "Run: bin/db gen (or sqlc generate)"
    diff -r --exclude=queries.go internal/db "$TMPDIR/db" || true
    exit 1
  fi
'

run "openapi-drift" go run ./cmd/dx-client-gen -check

run "ui-api-drift" bash -c '
  GO_HASH=internal/dxclient/openapi.json.sha256
  UI_HASH=ui/src/api.gen.ts.sha256
  if [ ! -f "$GO_HASH" ] || [ ! -f "$UI_HASH" ]; then
    exit 0
  fi
  if [ "$(cat "$GO_HASH")" != "$(cat "$UI_HASH")" ]; then
    echo "ui/src/api.gen.ts is stale — spec hash does not match internal/dxclient/openapi.json."
    echo "Run: ./bin/dx ui gen-api"
    exit 1
  fi
'

# ── Advisory checks (reported but don't fail the build) ──────────────────────

run "raw-api-calls" bash -c '
  TOTAL=0
  echo "── Go CLI (should use dxclient.APIClient) ──"
  GO_COUNT=$(grep -rn "c\.Get(\"/api/\|c\.Post(\"/api/\|c\.Delete(\"/api/" internal/cli/ --include="*.go" 2>/dev/null | wc -l)
  GO_FILES=$(grep -rln "c\.Get(\"/api/\|c\.Post(\"/api/\|c\.Delete(\"/api/" internal/cli/ --include="*.go" 2>/dev/null | wc -l)
  if [ "$GO_COUNT" -gt 0 ]; then
    echo "  $GO_COUNT callsites in $GO_FILES files"
    grep -rln "c\.Get(\"/api/\|c\.Post(\"/api/\|c\.Delete(\"/api/" internal/cli/ --include="*.go" 2>/dev/null | sed "s/^/    /"
    TOTAL=$((TOTAL + GO_COUNT))
  else
    echo "  clean"
  fi
  echo ""
  echo "── UI (should use openapi-fetch typed client) ──"
  # Detect raw apiFetch/apiPost calls that bypass the generated client
  UI_COUNT=$(grep -rn "apiFetch\|apiPost" ui/src/ --include="*.ts" --include="*.tsx" 2>/dev/null | grep -v "api.gen.ts\|node_modules\|// raw-ok" | wc -l)
  UI_FILES=$(grep -rln "apiFetch\|apiPost" ui/src/ --include="*.ts" --include="*.tsx" 2>/dev/null | grep -v "api.gen.ts\|node_modules" | wc -l)
  if [ "$UI_COUNT" -gt 0 ]; then
    echo "  $UI_COUNT callsites in $UI_FILES files"
    grep -rln "apiFetch\|apiPost" ui/src/ --include="*.ts" --include="*.tsx" 2>/dev/null | grep -v "api.gen.ts\|node_modules" | sed "s/^/    /"
    TOTAL=$((TOTAL + UI_COUNT))
  else
    echo "  clean"
  fi
  echo ""
  echo "total raw API callsites: $TOTAL"
  if [ "$TOTAL" -gt 0 ]; then
    exit 1
  fi
'

run "sql-metaquery-candidates" bash -c '
  # Flag queries using LIMIT (>1) or GROUP BY that should use metaquery instead.
  # Exempt: "-- metaquery: off" comment, LIMIT 1 (single-row lookups), :exec/:copyfrom.
  OUTPUT=$(awk '\''
    FNR==1 { file=FILENAME }
    /^-- name:/ { flush(); name=$3; cmd=$4; lineno=FNR; body=""; next }
    { body = body "\n" $0 }
    END { flush(); if (total>0) printf "\ntotal: %d queries (suppress per-query with: -- metaquery: off)\n", total }
    function flush() {
      if (name == "") return
      if (cmd == ":exec" || cmd == ":execrows" || cmd == ":copyfrom") return
      if (index(body, "metaquery: off") > 0) return
      upper = toupper(body)
      if (upper ~ /GROUP[[:space:]]+BY/) {
        printf "  %s:%d %s — GROUP BY (use metaquery aggregation)\n", file, lineno, name
        total++
      }
      if (upper ~ /LIMIT[[:space:]]+[\$@]/ || body ~ /LIMIT[[:space:]]+@/) {
        printf "  %s:%d %s — parameterized LIMIT (use metaquery pagination)\n", file, lineno, name
        total++
      } else if (upper ~ /LIMIT[[:space:]]+[0-9]/) {
        if (upper !~ /LIMIT[[:space:]]+1([^0-9]|$)/) {
          printf "  %s:%d %s — hardcoded LIMIT >1 (use metaquery pagination)\n", file, lineno, name
          total++
        }
      }
    }
  '\'' queries/*.sql)
  if [ -n "$OUTPUT" ]; then
    echo "Queries with LIMIT/GROUP BY that could use metaquery:"
    echo "$OUTPUT"
    exit 1
  fi
'

ADVISORY_LABELS=("raw-api-calls" "sql-metaquery-candidates")

# ── Wait and report ──────────────────────────────────────────────────────────

for i in "${!PIDS[@]}"; do
  set +e
  wait "${PIDS[$i]}"
  RC=$?
  set -e
  LABEL="${LABELS[$i]}"
  DUR=$(elapsed "$LABEL")
  ADVISORY=false
  for a in "${ADVISORY_LABELS[@]}"; do
    if [ "$LABEL" = "$a" ]; then ADVISORY=true; break; fi
  done
  if [ $RC -ne 0 ]; then
    if $ADVISORY; then
      echo ""
      echo "WARN: $LABEL ($DUR, advisory, not blocking)"
      cat "$LOGS_DIR/$LABEL.out"
    else
      echo ""
      echo "FAIL: $LABEL ($DUR)"
      cat "$LOGS_DIR/$LABEL.out"
      FAIL=1
    fi
  else
    echo "OK:   $LABEL ($DUR)"
  fi
done

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "[lint] Some checks failed."
  exit 1
fi

echo ""
echo "[lint] All checks passed."
