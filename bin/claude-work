#!/usr/bin/env bash
set -u

cd "$(dirname "$0")/.."

ALIAS=""
for arg in "$@"; do
  case "$arg" in
    --alias=*) ALIAS="${arg#--alias=}" ;;
  esac
done

mkdir -p .zdx/logs .zdx/cache
LOG=.zdx/logs/claude-work.log
STATE_FILE=.zdx/cache/claude-work-state

PROJECT_DIR="$HOME/.claude/projects/$(pwd | tr / -)"

# Load zdx remote config for session upload.
ZDX_URL="$(grep -A1 '^remote:' .zdx/config.yaml | grep 'url:' | awk '{print $2}' | tr -d '"'"'"'')"
ZDX_SLUG="$(grep -A2 '^remote:' .zdx/config.yaml | grep 'slug:' | awk '{print $2}' | tr -d '"'"'"'')"
ZDX_KEY="$(cat .zdx/credentials 2>/dev/null | tr -d '[:space:]')"

log() {
  printf '[%s] %s\n' "$(date -Iseconds)" "$*" | tee -a "$LOG"
}

SELF_HASH="$(sha1sum "$0" | awk '{print $1}')"

maybe_reexec() {
  local cur
  cur="$(sha1sum "$0" | awk '{print $1}')"
  if [[ "$cur" != "$SELF_HASH" ]]; then
    log "self-update: ${SELF_HASH:0:8} → ${cur:0:8}, re-execing"
    exec "$0" "$@"
  fi
}

stream_session_start() {
  local sid="$1" sfile="$2" issue_id="$3"
  if [[ -z "$ZDX_URL" || -z "$ZDX_SLUG" || -z "$ZDX_KEY" ]]; then
    return
  fi
  local url="${ZDX_URL}/api/dx/claude/sessions/ingest/stream?slug=${ZDX_SLUG}&session_id=${sid}&issue_id=${issue_id}&alias=${ALIAS}"
  tail -f "$sfile" 2>/dev/null | curl -s -o /dev/null -w '' \
    -X POST \
    -H "X-Api-Key: ${ZDX_KEY}" \
    -H "Content-Type: application/x-ndjson" \
    -T - \
    "$url" &
  STREAM_CURL_PID=$!
  log "stream: started (pid=$STREAM_CURL_PID)"
}

SUBAGENT_STREAM_PIDS=()
SUBAGENT_KNOWN_FILES=()
SUBAGENT_WATCHER_PID=""

stream_subagents_watch() {
  local sid="$1" issue_id="$2" base_dir="$3"
  while true; do
    sleep 2
    for subdir in $(find "$base_dir" -type d -name subagents 2>/dev/null); do
      for agent_jsonl in "$subdir"/agent-*.jsonl; do
        [[ -f "$agent_jsonl" ]] || continue
        local already=false
        for known in "${SUBAGENT_KNOWN_FILES[@]:-}"; do
          [[ "$known" == "$agent_jsonl" ]] && { already=true; break; }
        done
        $already && continue
        SUBAGENT_KNOWN_FILES+=("$agent_jsonl")
        local agent_file agent_id agent_meta agent_type="" agent_desc=""
        agent_file="$(basename "$agent_jsonl")"
        agent_id="${agent_file%.jsonl}"
        agent_meta="${agent_jsonl%.jsonl}.meta.json"
        local attempts=0
        while [[ ! -f "$agent_meta" && $attempts -lt 5 ]]; do
          sleep 0.5
          attempts=$(( attempts + 1 ))
        done
        if [[ -f "$agent_meta" ]] && command -v jq &>/dev/null; then
          agent_type="$(jq -r '.agentType // ""' "$agent_meta" 2>/dev/null)"
          agent_desc="$(jq -r '.description // ""' "$agent_meta" 2>/dev/null)"
        fi
        local url="${ZDX_URL}/api/dx/claude/sessions/ingest/stream?slug=${ZDX_SLUG}&session_id=${sid}&issue_id=${issue_id}&alias=${ALIAS}"
        url+="&agent_id=$(printf '%s' "$agent_id" | jq -sRr @uri)"
        url+="&agent_type=$(printf '%s' "$agent_type" | jq -sRr @uri)"
        url+="&agent_description=$(printf '%s' "$agent_desc" | jq -sRr @uri)"
        tail -f "$agent_jsonl" 2>/dev/null | curl -s -o /dev/null -w '' \
          -X POST \
          -H "X-Api-Key: ${ZDX_KEY}" \
          -H "Content-Type: application/x-ndjson" \
          -T - \
          "$url" &
        SUBAGENT_STREAM_PIDS+=($!)
        log "stream: subagent $agent_id started (pid=$!)"
      done
    done
  done
}

stream_subagents_start() {
  local sid="$1" issue_id="$2"
  if [[ -z "$ZDX_URL" || -z "$ZDX_SLUG" || -z "$ZDX_KEY" ]]; then
    return
  fi
  local base_dir="$PROJECT_DIR/$sid"
  SUBAGENT_KNOWN_FILES=()
  SUBAGENT_STREAM_PIDS=()
  stream_subagents_watch "$sid" "$issue_id" "$base_dir" &
  SUBAGENT_WATCHER_PID=$!
}

stream_session_stop() {
  if [[ -n "${SUBAGENT_WATCHER_PID:-}" ]]; then
    kill "$SUBAGENT_WATCHER_PID" 2>/dev/null
    wait "$SUBAGENT_WATCHER_PID" 2>/dev/null
    SUBAGENT_WATCHER_PID=""
  fi
  for pid in "${SUBAGENT_STREAM_PIDS[@]:-}"; do
    [[ -n "$pid" ]] && kill "$pid" 2>/dev/null && wait "$pid" 2>/dev/null
  done
  SUBAGENT_STREAM_PIDS=()
  log "stream: subagent streams stopped"
  if [[ -n "${STREAM_CURL_PID:-}" ]]; then
    kill "$STREAM_CURL_PID" 2>/dev/null
    wait "$STREAM_CURL_PID" 2>/dev/null
    log "stream: stopped"
    STREAM_CURL_PID=""
  fi
}

upload_session() {
  local sid="$1" sfile="$2" issue_id="$3"
  if [[ -z "$ZDX_URL" || -z "$ZDX_SLUG" || -z "$ZDX_KEY" ]]; then
    log "upload: skipped (no remote config)"
    return
  fi
  if [[ ! -f "$sfile" ]]; then
    log "upload: skipped (no session file)"
    return
  fi
  local url="${ZDX_URL}/api/dx/claude/sessions/ingest?slug=${ZDX_SLUG}&session_id=${sid}&issue_id=${issue_id}&alias=${ALIAS}"
  local http_code
  http_code=$(curl -s -o /dev/null -w '%{http_code}' \
    -X POST \
    -H "X-Api-Key: ${ZDX_KEY}" \
    -H "Content-Type: application/x-ndjson" \
    --data-binary "@${sfile}" \
    "$url")
  log "upload: session $sid → HTTP $http_code"
  # Upload subagent transcripts recursively
  upload_subagents "$sid" "$issue_id" "$(dirname "$sfile")/$sid/subagents"
}

upload_subagents() {
  local sid="$1" issue_id="$2" subdir="$3"
  [[ -d "$subdir" ]] || return 0
  for agent_jsonl in "$subdir"/agent-*.jsonl; do
    [[ -f "$agent_jsonl" ]] || continue
    local agent_file
    agent_file="$(basename "$agent_jsonl")"
    local agent_id="${agent_file%.jsonl}"
    local agent_meta="${agent_jsonl%.jsonl}.meta.json"
    local agent_type="" agent_desc=""
    if [[ -f "$agent_meta" ]] && command -v jq &>/dev/null; then
      agent_type="$(jq -r '.agentType // ""' "$agent_meta" 2>/dev/null)"
      agent_desc="$(jq -r '.description // ""' "$agent_meta" 2>/dev/null)"
    fi
    local url="${ZDX_URL}/api/dx/claude/sessions/ingest?slug=${ZDX_SLUG}&session_id=${sid}&issue_id=${issue_id}&alias=${ALIAS}"
    url+="&agent_id=$(printf '%s' "$agent_id" | jq -sRr @uri)"
    url+="&agent_type=$(printf '%s' "$agent_type" | jq -sRr @uri)"
    url+="&agent_description=$(printf '%s' "$agent_desc" | jq -sRr @uri)"
    local http_code
    http_code=$(curl -s -o /dev/null -w '%{http_code}' \
      -X POST \
      -H "X-Api-Key: ${ZDX_KEY}" \
      -H "Content-Type: application/x-ndjson" \
      --data-binary "@${agent_jsonl}" \
      "$url")
    log "upload: subagent $agent_id → HTTP $http_code"
    # Recurse into nested subagents
    local nested_subdir="${agent_jsonl%.jsonl}/subagents"
    upload_subagents "$sid" "$issue_id" "$nested_subdir"
  done
}

# Ctrl+C exits immediately.
on_int() {
  log "interrupt: exiting"
  kill 0 2>/dev/null
  exit 130
}
trap on_int INT

save_state() {
  printf '%s\n%s\n' "$1" "$2" > "$STATE_FILE"
}

clear_state() {
  rm -f "$STATE_FILE"
}

load_state() {
  if [[ -f "$STATE_FILE" ]]; then
    saved_issue="$(sed -n '1p' "$STATE_FILE")"
    saved_sid="$(sed -n '2p' "$STATE_FILE")"
    if [[ -n "$saved_issue" ]]; then
      local status
      status="$(./bin/dx todo show "$saved_issue" 2>/dev/null | grep -oP '^Status:\s+\K\S+')"
      if [[ "$status" == "open" ]]; then
        log "resuming interrupted session: issue=$saved_issue sid=$saved_sid"
        return 0
      fi
      log "stale state: $saved_issue is $status, clearing"
    fi
    clear_state
  fi
  return 1
}

while true; do
  maybe_reexec "$@"
  resumed=false
  if load_state; then
    issue_id="$saved_issue"
    sid="$saved_sid"
    todo="$(./bin/dx todo solo --issue="$issue_id" 2>/dev/null)"
    if [[ $? -ne 0 || -z "$todo" ]]; then
      log "resumed issue $issue_id has no remaining work, clearing state"
      clear_state
      continue
    fi
    resumed=true
    log "todo solo --issue=$issue_id (resumed):"
    printf '%s\n' "$todo" | tee -a "$LOG"
  else
    todo="$(./bin/dx todo solo 2>/dev/null)"
    if [[ $? -eq 0 && -n "$todo" ]]; then
      log "todo solo:"
      printf '%s\n' "$todo" | tee -a "$LOG"
      issue_id="$(printf '%s' "$todo" | grep -oP 'IS-\d+' | head -1)"
      sid="$(uuidgen)"
    else
      log "idle; sleeping 60s"
      sleep 60
      continue
    fi
  fi

  sfile="$PROJECT_DIR/$sid.jsonl"
  save_state "${issue_id:-}" "$sid"
  mkdir -p "$PROJECT_DIR"

  # Session header
  start_time="$(date -Iseconds)"
  trigger_desc="$(printf '%s' "$todo" | head -1 | sed 's/^[[:space:]]*//')"
  log "──────────────────────────────────────────────"
  log "SESSION START"
  log "  session:  $sid"
  log "  issue:    ${issue_id:-none}"
  log "  trigger:  $trigger_desc"
  log "  started:  $start_time"
  log "  file:     $sfile"
  log "  resumed:  $resumed"
  log "──────────────────────────────────────────────"

  if [[ "$resumed" == true ]]; then
    prev_sid="$sid"
    sid="$(uuidgen)"
    sfile="$PROJECT_DIR/$sid.jsonl"
    save_state "${issue_id:-}" "$sid"
    log "forking session: $prev_sid → $sid"
  fi

  render_fifo="$(mktemp -u)"
  mkfifo "$render_fifo"
  tail -F "$sfile" 2>/dev/null > "$render_fifo" &
  tail_pid=$!
  bin/claude-work-render < "$render_fifo" | tee -a "$LOG" &
  render_pid=$!

  # Start streaming events to server for real-time WebSocket updates.
  touch "$sfile"
  stream_session_start "$sid" "$sfile" "${issue_id:-}"
  stream_subagents_start "$sid" "${issue_id:-}"

  if [[ "$resumed" == true ]]; then
    claude --dangerously-skip-permissions --chrome \
      --resume "$prev_sid" --fork-session --session-id "$sid" -p /work
  else
    claude --dangerously-skip-permissions --chrome \
      --session-id "$sid" -p /work
  fi
  rc=$?

  kill "$tail_pid" 2>/dev/null
  wait "$tail_pid" 2>/dev/null
  wait "$render_pid" 2>/dev/null
  rm -f "$render_fifo"

  # Stop streaming — batch upload below catches any missed events.
  stream_session_stop

  # Session summary
  end_time="$(date -Iseconds)"
  event_count=0
  total_input=0
  total_output=0
  total_cache_read=0
  total_cache_create=0
  if [[ -f "$sfile" ]]; then
    event_count="$(wc -l < "$sfile")"
    # Extract token usage from assistant events with jq if available
    if command -v jq &>/dev/null; then
      usage_sums="$(jq -r 'select(.type == "assistant" and .message.usage != null) | .message.usage | [(.input_tokens // 0), (.output_tokens // 0), (.cache_read_input_tokens // 0), (.cache_creation_input_tokens // 0)] | @tsv' "$sfile" 2>/dev/null | awk -F'\t' '{i+=$1; o+=$2; cr+=$3; cc+=$4} END {printf "%d %d %d %d", i, o, cr, cc}')"
      read -r total_input total_output total_cache_read total_cache_create <<< "$usage_sums"
      # Sum subagent usage
      subagent_dir="$PROJECT_DIR/$sid/subagents"
      if [[ -d "$subagent_dir" ]]; then
        for agent_jsonl in "$subagent_dir"/agent-*.jsonl; do
          [[ -f "$agent_jsonl" ]] || continue
          agent_sums="$(jq -r 'select(.type == "assistant" and .message.usage != null) | .message.usage | [(.input_tokens // 0), (.output_tokens // 0), (.cache_read_input_tokens // 0), (.cache_creation_input_tokens // 0)] | @tsv' "$agent_jsonl" 2>/dev/null | awk -F'\t' '{i+=$1; o+=$2; cr+=$3; cc+=$4} END {printf "%d %d %d %d", i, o, cr, cc}')"
          read -r ai ao acr acc <<< "$agent_sums"
          total_input=$(( total_input + ai ))
          total_output=$(( total_output + ao ))
          total_cache_read=$(( total_cache_read + acr ))
          total_cache_create=$(( total_cache_create + acc ))
          # Per-agent breakdown
          agent_meta="${agent_jsonl%.jsonl}.meta.json"
          agent_label="$(basename "$agent_jsonl")"
          if [[ -f "$agent_meta" ]]; then
            agent_type="$(jq -r '.agentType // "unknown"' "$agent_meta" 2>/dev/null)"
            agent_desc="$(jq -r '.description // ""' "$agent_meta" 2>/dev/null)"
            agent_label="${agent_type}: ${agent_desc}"
          fi
          log "  subagent:  ${agent_label}  input=$ai output=$ao cache_read=$acr cache_create=$acc"
        done
      fi
    fi
  fi
  duration_s=$(( $(date +%s) - $(date -d "$start_time" +%s) ))
  duration_m=$(( duration_s / 60 ))
  duration_rem=$(( duration_s % 60 ))
  log "──────────────────────────────────────────────"
  log "SESSION END"
  log "  session:   $sid"
  log "  issue:     ${issue_id:-none}"
  log "  exit code: $rc"
  log "  duration:  ${duration_m}m${duration_rem}s"
  log "  events:    $event_count"
  log "  tokens:    input=$total_input output=$total_output cache_read=$total_cache_read cache_create=$total_cache_create"
  log "  ended:     $end_time"
  log "──────────────────────────────────────────────"

  upload_session "$sid" "$sfile" "${issue_id:-}"
  clear_state
done
