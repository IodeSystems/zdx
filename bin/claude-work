#!/usr/bin/env bash
set -u

cd "$(dirname "$0")/.."

ALIAS=""
for arg in "$@"; do
  case "$arg" in
    --alias=*) ALIAS="${arg#--alias=}" ;;
  esac
done

mkdir -p .zdx/logs .zdx/cache
LOG=.zdx/logs/claude-work.log
STATE_FILE=.zdx/cache/claude-work-state

PROJECT_DIR="$HOME/.claude/projects/$(pwd | tr / -)"

# Load zdx remote config for session upload.
ZDX_URL="$(grep -A1 '^remote:' .zdx/config.yaml | grep 'url:' | awk '{print $2}' | tr -d '"'"'"'')"
ZDX_SLUG="$(grep -A2 '^remote:' .zdx/config.yaml | grep 'slug:' | awk '{print $2}' | tr -d '"'"'"'')"
ZDX_KEY="$(cat .zdx/credentials 2>/dev/null | tr -d '[:space:]')"

log() {
  printf '[%s] %s\n' "$(date -Iseconds)" "$*" | tee -a "$LOG"
}

upload_session() {
  local sid="$1" sfile="$2" issue_id="$3"
  if [[ -z "$ZDX_URL" || -z "$ZDX_SLUG" || -z "$ZDX_KEY" ]]; then
    log "upload: skipped (no remote config)"
    return
  fi
  if [[ ! -f "$sfile" ]]; then
    log "upload: skipped (no session file)"
    return
  fi
  local url="${ZDX_URL}/api/dx/claude/sessions/ingest?slug=${ZDX_SLUG}&session_id=${sid}&issue_id=${issue_id}&alias=${ALIAS}"
  local http_code
  http_code=$(curl -s -o /dev/null -w '%{http_code}' \
    -X POST \
    -H "X-Api-Key: ${ZDX_KEY}" \
    -H "Content-Type: application/x-ndjson" \
    --data-binary "@${sfile}" \
    "$url")
  log "upload: session $sid → HTTP $http_code"
}

# Two Ctrl+C within 2s exits the loop; a single Ctrl+C just interrupts the
# current claude/sleep and continues to the next iteration.
last_int=0
on_int() {
  now=$(date +%s)
  if (( now - last_int <= 2 )); then
    log "interrupt: exiting"
    kill 0 2>/dev/null
    exit 130
  fi
  last_int=$now
  log "interrupt: press Ctrl+C again within 2s to exit"
}
trap on_int INT

save_state() {
  printf '%s\n%s\n' "$1" "$2" > "$STATE_FILE"
}

clear_state() {
  rm -f "$STATE_FILE"
}

load_state() {
  if [[ -f "$STATE_FILE" ]]; then
    saved_issue="$(sed -n '1p' "$STATE_FILE")"
    saved_sid="$(sed -n '2p' "$STATE_FILE")"
    if [[ -n "$saved_issue" ]]; then
      local status
      status="$(./bin/dx todo show "$saved_issue" 2>/dev/null | grep -oP '^Status:\s+\K\S+')"
      if [[ "$status" == "open" ]]; then
        log "resuming interrupted session: issue=$saved_issue sid=$saved_sid"
        return 0
      fi
      log "stale state: $saved_issue is $status, clearing"
    fi
    clear_state
  fi
  return 1
}

while true; do
  resumed=false
  if load_state; then
    issue_id="$saved_issue"
    sid="$saved_sid"
    todo="$(./bin/dx todo solo --issue="$issue_id" 2>/dev/null)"
    if [[ -z "$todo" ]]; then
      log "resumed issue $issue_id has no remaining work, clearing state"
      clear_state
      continue
    fi
    resumed=true
    log "todo solo --issue=$issue_id (resumed):"
    printf '%s\n' "$todo" | tee -a "$LOG"
  else
    todo="$(./bin/dx todo solo 2>/dev/null)"
    if [[ -n "$todo" ]]; then
      log "todo solo:"
      printf '%s\n' "$todo" | tee -a "$LOG"
      issue_id="$(printf '%s' "$todo" | grep -oP 'IS-\d+' | head -1)"
      sid="$(uuidgen)"
    else
      log "idle; sleeping 60s"
      sleep 60
      continue
    fi
  fi

  sfile="$PROJECT_DIR/$sid.jsonl"
  save_state "${issue_id:-}" "$sid"
  mkdir -p "$PROJECT_DIR"

  # Session header
  start_time="$(date -Iseconds)"
  trigger_desc="$(printf '%s' "$todo" | head -1 | sed 's/^[[:space:]]*//')"
  log "──────────────────────────────────────────────"
  log "SESSION START"
  log "  session:  $sid"
  log "  issue:    ${issue_id:-none}"
  log "  trigger:  $trigger_desc"
  log "  started:  $start_time"
  log "  file:     $sfile"
  log "  resumed:  $resumed"
  log "──────────────────────────────────────────────"

  tail -F "$sfile" 2>/dev/null | bin/claude-work-render | tee -a "$LOG" &
  tail_pid=$!

  if [[ "$resumed" == true ]]; then
    claude --dangerously-skip-permissions --chrome \
      --session-id "$sid" --continue -p /work
  else
    claude --dangerously-skip-permissions --chrome \
      --session-id "$sid" -p /work
  fi
  rc=$?

  kill "$tail_pid" 2>/dev/null
  wait "$tail_pid" 2>/dev/null

  # Session summary
  end_time="$(date -Iseconds)"
  event_count=0
  total_input=0
  total_output=0
  total_cache_read=0
  total_cache_create=0
  if [[ -f "$sfile" ]]; then
    event_count="$(wc -l < "$sfile")"
    # Extract token usage from assistant events with jq if available
    if command -v jq &>/dev/null; then
      usage_sums="$(jq -r 'select(.type == "assistant" and .message.usage != null) | .message.usage | [(.input_tokens // 0), (.output_tokens // 0), (.cache_read_input_tokens // 0), (.cache_creation_input_tokens // 0)] | @tsv' "$sfile" 2>/dev/null | awk -F'\t' '{i+=$1; o+=$2; cr+=$3; cc+=$4} END {printf "%d %d %d %d", i, o, cr, cc}')"
      read -r total_input total_output total_cache_read total_cache_create <<< "$usage_sums"
    fi
  fi
  duration_s=$(( $(date +%s) - $(date -d "$start_time" +%s) ))
  duration_m=$(( duration_s / 60 ))
  duration_rem=$(( duration_s % 60 ))
  log "──────────────────────────────────────────────"
  log "SESSION END"
  log "  session:   $sid"
  log "  issue:     ${issue_id:-none}"
  log "  exit code: $rc"
  log "  duration:  ${duration_m}m${duration_rem}s"
  log "  events:    $event_count"
  log "  tokens:    input=$total_input output=$total_output cache_read=$total_cache_read cache_create=$total_cache_create"
  log "  ended:     $end_time"
  log "──────────────────────────────────────────────"

  upload_session "$sid" "$sfile" "${issue_id:-}"
  clear_state
done
