#!/usr/bin/env bash
# Reads Claude Code JSONL from stdin and renders ANSI-formatted terminal output.
set -u

RST=$'\033[0m'
DIM=$'\033[2m'
BOLD=$'\033[1m'
CYAN=$'\033[36m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
MAGENTA=$'\033[35m'
WHITE=$'\033[37m'
BLUE=$'\033[34m'

while IFS= read -r line; do
  # Skip empty lines
  [[ -z "$line" ]] && continue

  parsed=$(jq -r '
    def trunc(n): if length > n then .[0:n] + "…" else . end;
    def first_content: .message.content[0] // {};
    .type as $type |
    first_content as $c |
    if $type == "queue-operation" or $type == "attachment" then
      empty
    elif $type == "ai-title" then
      "TITLE\t" + (.title // "untitled")
    elif $type == "assistant" then
      if $c.type == "text" then
        "TEXT\t" + ($c.text // "" | gsub("\n"; " ") | trunc(200))
      elif $c.type == "tool_use" then
        $c.name as $tool |
        (if $tool == "Bash" then
          "$ " + ($c.input.command // "" | gsub("\n"; " ") | trunc(120))
        elif $tool == "Read" then
          ($c.input.file_path // "") + (if $c.input.offset then " +" + ($c.input.offset | tostring) else "" end)
        elif $tool == "Write" then
          ($c.input.file_path // "")
        elif $tool == "Edit" then
          ($c.input.file_path // "")
        elif $tool == "Grep" then
          "/" + ($c.input.pattern // "") + "/ " + ($c.input.path // $c.input.glob // ".")
        elif $tool == "Glob" then
          ($c.input.pattern // "") + " " + ($c.input.path // ".")
        elif $tool == "Agent" then
          ($c.input.description // "agent")
        else
          ($c.input | tostring | trunc(80))
        end) as $detail |
        "TOOL\t" + $tool + "\t" + $detail
      elif $c.type == "thinking" then
        "THINK\t" + ($c.thinking // "" | gsub("\n"; " ") | trunc(100))
      else
        empty
      end
    elif $type == "user" then
      if $c.type == "tool_result" then
        "RESULT\t" + (if $c.is_error then "ERR" else "OK" end) + "\t" + ($c.content // "" | tostring | gsub("\n"; " ") | trunc(120))
      else
        empty
      end
    else
      empty
    end
  ' <<< "$line" 2>/dev/null)

  [[ -z "$parsed" ]] && continue

  kind="${parsed%%	*}"
  rest="${parsed#*	}"

  case "$kind" in
    TITLE)
      printf '%s%s● %s%s\n' "$BOLD" "$MAGENTA" "$rest" "$RST"
      ;;
    TEXT)
      printf '%s%s%s\n' "$WHITE" "$rest" "$RST"
      ;;
    TOOL)
      tool="${rest%%	*}"
      detail="${rest#*	}"
      printf '%s%s[%s]%s %s%s%s\n' "$BOLD" "$CYAN" "$tool" "$RST" "$DIM" "$detail" "$RST"
      ;;
    THINK)
      printf '%s%s⟡ %s%s\n' "$DIM" "$BLUE" "$rest" "$RST"
      ;;
    RESULT)
      status="${rest%%	*}"
      content="${rest#*	}"
      if [[ "$status" == "ERR" ]]; then
        printf '%s✗ %s%s\n' "$RED" "$content" "$RST"
      else
        printf '%s%s✓ %s%s\n' "$DIM" "$GREEN" "$content" "$RST"
      fi
      ;;
  esac
done
